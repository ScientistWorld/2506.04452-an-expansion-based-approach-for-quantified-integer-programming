# Apptainer definition file for this environment.
#
# Build:  apptainer build container.sif container.def
#
# The container packages everything a scientist agent needs to work on
# the agent's workspace is bind-mounted at /home/user at runtime.
#
# *** IMPORTANT ***
# Python packages (torch, transformers, etc.) go in setup.sh, NOT here.
# Only OS-level packages (apt-get) belong in %post.

# --- Base image ---
# Use a stable public Python base image to avoid transient MCR fetch failures.
Bootstrap: docker
From: python:3.11-slim

%files
    # data/train.csv /home/user/data/train.csv
    # data/test_features.csv /home/user/data/test_features.csv
    # baseline.py /home/user/baseline.py
    # sample_output.csv /home/user/sample_output.csv
    # test_initial_state.py /home/user/test_initial_state.py

%post
    apt-get update && apt-get install -y --no-install-recommends \
        nano vim-tiny less curl wget git && \
    rm -rf /var/lib/apt/lists/*

    ln -sf /usr/bin/vim.tiny /usr/bin/vim || true

    mkdir -p /home/user/data
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install Python packages into the container overlay.
    #
    # This script is run by the system on the login node (which has internet)
    # inside the container with a persistent overlay. Changes persist across
    # job submissions without rebuilding the container.
    #
    # IMPORTANT: Install into the SYSTEM Python, not a virtual environment.
    # The overlay may be recreated on container rebuilds — a venv inside
    # it will be lost and all subsequent jobs will fail.
    # Use: uv pip install --system
    # Do NOT create a venv (python -m venv, virtualenv, etc.).
    
    set -e
    
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    WHEEL_DIR="${SCRIPT_DIR}/wheels"
    
    # Install vendored cp311 wheels to avoid long setup-time network resolution
    # or source builds. HiGHS is the default LP/MIP backend; OR-Tools CP-SAT is
    # additionally installed for the universal wins1 subproblems in auto mode.
    uv pip install --system \
        "${WHEEL_DIR}/numpy-2.2.6-cp311-cp311-manylinux_2_17_x86_64.manylinux2014_x86_64.whl" \
        "${WHEEL_DIR}/highspy-1.11.0-cp311-cp311-manylinux_2_17_x86_64.manylinux2014_x86_64.whl" \
        "ortools>=9.9,<10"

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
